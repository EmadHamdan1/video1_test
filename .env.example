# Copy to .env locally. Never commit real keys.
# Openverse works anonymously at limited rate; register to use higher limits.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional API sources
PIXABAY_API_KEY=
PEXELS_API_KEY=
FREESOUND_API_KEY=

# Optional Hugging Face Inference Providers image generation (may consume credits)
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
